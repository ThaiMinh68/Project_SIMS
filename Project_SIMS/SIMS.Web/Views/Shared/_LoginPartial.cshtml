@using Microsoft.AspNetCore.Identity
@using SIMS.Domain.Entities
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<div class="d-flex flex-column gap-2 w-100">
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var initials = user?.FirstName?.Substring(0, 1) + user?.LastName?.Substring(0, 1);
    
    <div class="d-flex align-items-center mb-2">
        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px; font-weight: bold;">
            @(initials ?? "U")
        </div>
        <div class="ms-3 sidebar-user-info overflow-hidden">
            <div class="fw-bold text-truncate" style="font-size: 0.9rem;">@user?.FirstName @user?.LastName</div>
            <div class="text-muted text-truncate" style="font-size: 0.75rem;">@UserManager.GetUserName(User)</div>
        </div>
    </div>
    
    <form class="form-inline w-100 sidebar-user-info" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button type="submit" class="btn btn-outline-danger w-100 btn-sm">
            <i class="fas fa-sign-out-alt me-1"></i> Logout
        </button>
    </form>
}
else
{
    <a class="btn btn-outline-primary btn-sm sidebar-user-info" asp-area="Identity" asp-page="/Account/Register">Register</a>
    <a class="btn btn-primary text-white btn-sm sidebar-user-info" asp-area="Identity" asp-page="/Account/Login">Login</a>
}
</div>
