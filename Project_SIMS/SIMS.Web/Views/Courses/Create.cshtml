@model SIMS.Application.DTOs.CreateCourseDto

@{
    ViewData["Title"] = "Add New Course";
}

<div class="container-fluid px-4">
    <h1 class="mt-4 text-primary"><i class="bi bi-book-half"></i> @ViewData["Title"]</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Course Management</a></li>
        <li class="breadcrumb-item active">Add New</li>
    </ol>

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-white pt-4 pb-0">
            <h5 class="mb-0">Course Information</h5>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Code" class="form-label fw-bold">Course Code</label>
                        <input asp-for="Code" class="form-control" placeholder="Ex: PRN211" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Course Name</label>
                        <input asp-for="Title" class="form-control" placeholder="Basic Cross-Platform App with .NET" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="col-md-2 mb-3">
                        <label asp-for="Credits" class="form-label fw-bold">Credits</label>
                        <input asp-for="Credits" type="number" class="form-control" value="3" />
                        <span asp-validation-for="Credits" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Course Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="DepartmentId" class="form-label fw-bold">Department</label>
                        <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments">
                            <option value="">-- Select Department --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="AssignedFacultyId" class="form-label fw-bold">Assign Faculty (Optional)</label>
                        <select asp-for="AssignedFacultyId" class="form-select" asp-items="ViewBag.Faculties">
                            <option value="">-- Unassigned --</option>
                        </select>
                        <span asp-validation-for="AssignedFacultyId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="PrerequisiteCourseId" class="form-label fw-bold">Prerequisite Course (Optional)</label>
                        <select asp-for="PrerequisiteCourseId" class="form-select" asp-items="ViewBag.Prerequisites">
                            <option value="">-- None --</option>
                        </select>
                        <span asp-validation-for="PrerequisiteCourseId" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save"></i> Save Course</button>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
