@model IEnumerable<dynamic>

@{
	ViewData["Title"] = "Account Management";
}

<div class="container-fluid px-4">
	<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
		<h1 class="text-danger"><i class="bi bi-shield-lock-fill"></i> @ViewData["Title"]</h1>
	</div>

	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			<i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	@if (TempData["ErrorMessage"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			<i class="bi bi-exclamation-circle-fill"></i> @TempData["ErrorMessage"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<div class="card mb-4 shadow-sm border-0">
		<div class="card-header bg-white pt-4 pb-0">
			<h5 class="mb-0">All User Accounts</h5>
		</div>
		<div class="card-body">
			@if (Model != null && Model.Any())
			{
				<div class="table-responsive">
					<table class="table table-hover align-middle">
						<thead class="table-light">
							<tr>
								<th>Email</th>
								<th>Full Name</th>
								<th>Roles</th>
								<th>Status</th>
								<th>Created</th>
								<th class="text-end">Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model)
							{
								<tr>
									<td>@item.Email</td>
									<td class="fw-bold">@item.Name</td>
									<td>
										@foreach (var role in item.Roles.Split(", "))
										{
											<span class="badge bg-secondary me-1">@role</span>
										}
									</td>
									<td>
										@if (item.IsActive)
										{
											<span class="badge bg-success">Active</span>
										}
										else
										{
											<span class="badge bg-danger">Locked</span>
										}
									</td>
									<td>
										<small>@item.CreatedAt.ToString("dd/MM/yyyy")</small>
									</td>
									<td class="text-end">
										<a asp-action="AccountEdit" asp-controller="Admin" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
											<i class="bi bi-pencil"></i> Edit
										</a>
										<form asp-action="ResetPassword" asp-controller="Admin" asp-route-id="@item.Id" method="post" class="d-inline me-1" 
											  onsubmit="return confirm('Reset password for this user?');">
											<button type="submit" class="btn btn-sm btn-outline-warning">
												<i class="bi bi-arrow-clockwise"></i> Reset
											</button>
										</form>
										<form asp-action="LockUnlockAccount" asp-controller="Admin" asp-route-id="@item.Id" method="post" class="d-inline" 
											  onsubmit="return confirm('Are you sure?');">
											<button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")">
												@if (item.IsActive)
												{
													<i class="bi bi-lock-fill"></i> <span>Lock</span>
												}
												else
												{
													<i class="bi bi-unlock-fill"></i> <span>Unlock</span>
												}
											</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			else
			{
				<div class="alert alert-info" role="alert">
					<i class="bi bi-info-circle"></i> No user accounts found.
				</div>
			}
		</div>
	</div>
</div>
