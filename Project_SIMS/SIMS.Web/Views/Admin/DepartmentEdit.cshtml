@model SIMS.Domain.Entities.Department

@{
	ViewData["Title"] = "Edit Department";
}

<div class="container-fluid px-4">
	<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
		<h1 class="text-info"><i class="bi bi-pencil-square"></i> @ViewData["Title"]</h1>
		<a asp-action="DepartmentIndex" asp-controller="Admin" class="btn btn-outline-secondary">
			<i class="bi bi-arrow-left"></i> Back to List
		</a>
	</div>

	<div class="row">
		<div class="col-lg-6 offset-lg-3">
			<div class="card shadow-sm border-0">
				<div class="card-header bg-white pt-4 pb-0">
					<h5 class="mb-0">Department Information</h5>
				</div>
				<div class="card-body">
					<form asp-action="DepartmentEdit" asp-controller="Admin" method="post">
						<input type="hidden" name="id" value="@Model.Id">

						<div class="mb-3">
							<label for="code" class="form-label">Department Code</label>
							<input type="text" class="form-control" 
								   id="code" name="code" value="@Model.Code" required>
							<small class="text-muted">Unique code for the department</small>
						</div>

						<div class="mb-3">
							<label for="name" class="form-label">Department Name</label>
							<input type="text" class="form-control" 
								   id="name" name="name" value="@Model.Name" required>
						</div>

						@if (!ViewData.ModelState.IsValid)
						{
							<div class="alert alert-danger" role="alert">
								<h6 class="alert-heading">Please correct the following errors:</h6>
								<ul class="mb-0">
									@foreach (var modelState in ViewData.ModelState.Values)
									{
										@foreach (var error in modelState.Errors)
										{
											<li>@error.ErrorMessage</li>
										}
									}
								</ul>
							</div>
						}

						<div class="d-flex gap-2 pt-3">
							<button type="submit" class="btn btn-info">
								<i class="bi bi-check-circle"></i> Update Department
							</button>
							<a asp-action="DepartmentIndex" asp-controller="Admin" class="btn btn-outline-secondary">
								<i class="bi bi-x-circle"></i> Cancel
							</a>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
