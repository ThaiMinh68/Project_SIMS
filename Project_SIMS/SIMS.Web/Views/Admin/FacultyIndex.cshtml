@model IEnumerable<dynamic>

@{
	ViewData["Title"] = "Faculty Management";
}

<div class="container-fluid px-4">
	<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
		<h1 class="text-success"><i class="bi bi-person-badge-fill"></i> @ViewData["Title"]</h1>
		<a asp-action="FacultyCreate" asp-controller="Admin" class="btn btn-success">
			<i class="bi bi-plus-lg"></i> Add New Faculty
		</a>
	</div>

	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			<i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	@if (TempData["ErrorMessage"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			<i class="bi bi-exclamation-circle-fill"></i> @TempData["ErrorMessage"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<div class="card mb-4 shadow-sm border-0">
		<div class="card-header bg-white pt-4 pb-0">
			<h5 class="mb-0">All Faculty Members</h5>
		</div>
		<div class="card-body">
			@if (Model != null && Model.Any())
			{
				<div class="table-responsive">
					<table class="table table-hover align-middle">
						<thead class="table-light">
							<tr>
								<th>Faculty ID</th>
								<th>Full Name</th>
								<th>Email</th>
								<th>Title</th>
								<th>Department</th>
								<th>Hire Date</th>
								<th>Status</th>
								<th class="text-end">Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model)
							{
								<tr>
									<td><span class="badge bg-success">@item.FacultyId</span></td>
									<td class="fw-bold">@item.Name</td>
									<td><a href="mailto:@item.Email">@item.Email</a></td>
									<td>@item.Title</td>
									<td>@item.Department</td>
									<td>@item.HireDate.ToString("dd/MM/yyyy")</td>
									<td>
										@if (item.IsActive)
										{
											<span class="badge bg-success">Active</span>
										}
										else
										{
											<span class="badge bg-danger">Inactive</span>
										}
									</td>
									<td class="text-end">
										<a asp-action="FacultyEdit" asp-controller="Admin" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
											<i class="bi bi-pencil"></i> Edit
										</a>
										<form asp-action="FacultyDelete" asp-controller="Admin" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this faculty member and their login account?');">
											<button type="submit" class="btn btn-sm btn-outline-danger">
												<i class="bi bi-trash"></i> Delete
											</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			else
			{
				<div class="alert alert-info" role="alert">
					<i class="bi bi-info-circle"></i> No faculty members found. <a asp-action="FacultyCreate" asp-controller="Admin">Create one now</a>
				</div>
			}
		</div>
	</div>
</div>
