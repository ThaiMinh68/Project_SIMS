@{
	ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<h2>Admin Dashboard</h2>
	<div class="text-muted">System Statistics</div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
	<div class="col-md-6 col-lg-3">
		<div class="card bg-primary text-white h-100">
			<div class="card-body">
				<div class="d-flex justify-content-between align-items-center">
					<div>
						<h6 class="text-uppercase mb-1">Total Students</h6>
						<h2 class="mb-0 display-5 fw-bold">@ViewBag.TotalStudents</h2>
					</div>
					<i class="fas fa-user-graduate fa-3x opacity-50"></i>
				</div>
			</div>
			<div class="card-footer d-flex align-items-center justify-content-between border-0 bg-primary bg-opacity-75">
				<a class="text-white text-decoration-none stretched-link" href="/Admin/StudentIndex">View Details <i class="fas fa-angle-right"></i></a>
			</div>
		</div>
	</div>

	<div class="col-md-6 col-lg-3">
		<div class="card bg-success text-white h-100">
			<div class="card-body">
				<div class="d-flex justify-content-between align-items-center">
					<div>
						<h6 class="text-uppercase mb-1">Total Faculties</h6>
						<h2 class="mb-0 display-5 fw-bold">@ViewBag.TotalFaculties</h2>
					</div>
					<i class="fas fa-chalkboard-user fa-3x opacity-50"></i>
				</div>
			</div>
			<div class="card-footer d-flex align-items-center justify-content-between border-0 bg-success bg-opacity-75">
				<a class="text-white text-decoration-none stretched-link" href="/Admin/FacultyIndex">View Details <i class="fas fa-angle-right"></i></a>
			</div>
		</div>
	</div>

	<div class="col-md-6 col-lg-3">
		<div class="card bg-info text-white h-100">
			<div class="card-body">
				<div class="d-flex justify-content-between align-items-center">
					<div>
						<h6 class="text-uppercase mb-1">Total Departments</h6>
						<h2 class="mb-0 display-5 fw-bold">@ViewBag.TotalDepartments</h2>
					</div>
					<i class="fas fa-building fa-3x opacity-50"></i>
				</div>
			</div>
			<div class="card-footer d-flex align-items-center justify-content-between border-0 bg-info bg-opacity-75">
				<a class="text-white text-decoration-none stretched-link" href="/Admin/DepartmentIndex">View Details <i class="fas fa-angle-right"></i></a>
			</div>
		</div>
	</div>

	<div class="col-md-6 col-lg-3">
		<div class="card bg-warning text-dark h-100">
			<div class="card-body">
				<div class="d-flex justify-content-between align-items-center">
					<div>
						<h6 class="text-uppercase mb-1">Total Courses</h6>
						<h2 class="mb-0 display-5 fw-bold">@ViewBag.TotalCourses</h2>
					</div>
					<i class="fas fa-book fa-3x opacity-50"></i>
				</div>
			</div>
			<div class="card-footer d-flex align-items-center justify-content-between border-0 bg-warning bg-opacity-75">
				<a class="text-dark text-decoration-none stretched-link" href="/Admin/CourseIndex">View Details <i class="fas fa-angle-right"></i></a>
			</div>
		</div>
	</div>
</div>

<!-- Charts -->
<div class="row mb-4">
	<div class="col-md-6">
		<div class="card">
			<div class="card-header bg-white">
				<h5 class="card-title mb-0">Students by Department</h5>
			</div>
			<div class="card-body">
				<canvas id="studentsByDepartmentChart"></canvas>
			</div>
		</div>
	</div>

	<div class="col-md-6">
		<div class="card">
			<div class="card-header bg-white">
				<h5 class="card-title mb-0">Courses by Department</h5>
			</div>
			<div class="card-body">
				<canvas id="coursesByDepartmentChart"></canvas>
			</div>
		</div>
	</div>
</div>

<!-- Additional Chart -->
<div class="row mb-4">
	<div class="col-md-12">
		<div class="card">
			<div class="card-header bg-white">
				<h5 class="card-title mb-0">Enrollment Trend</h5>
			</div>
			<div class="card-body">
				<canvas id="enrollmentTrendChart"></canvas>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script>
		// Students by Department Chart
		const studentsByDeptData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.StudentsByDepartment));
		const studentDeptCtx = document.getElementById('studentsByDepartmentChart').getContext('2d');
		new Chart(studentDeptCtx, {
			type: 'doughnut',
			data: {
				labels: studentsByDeptData.map(d => d.department),
				datasets: [{
					data: studentsByDeptData.map(d => d.count),
					backgroundColor: [
						'#0d6efd', '#198754', '#0dcaf0', '#fd7e14', '#dc3545',
						'#6c757d', '#6f42c1', '#e83e8c'
					]
				}]
			},
			options: {
				responsive: true,
				maintainAspectRatio: true,
				plugins: {
					legend: {
						position: 'bottom'
					}
				}
			}
		});

		// Courses by Department Chart
		const coursesByDeptData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CoursesByDepartment));
		const courseDeptCtx = document.getElementById('coursesByDepartmentChart').getContext('2d');
		new Chart(courseDeptCtx, {
			type: 'bar',
			data: {
				labels: coursesByDeptData.map(d => d.department),
				datasets: [{
					label: 'Number of Courses',
					data: coursesByDeptData.map(d => d.count),
					backgroundColor: '#0d6efd',
					borderColor: '#0d6efd',
					borderWidth: 1
				}]
			},
			options: {
				responsive: true,
				maintainAspectRatio: true,
				indexAxis: 'y',
				plugins: {
					legend: {
						display: true
					}
				},
				scales: {
					x: {
						beginAtZero: true
					}
				}
			}
		});

		// Enrollment Trend Chart
		const enrollmentTrendCtx = document.getElementById('enrollmentTrendChart').getContext('2d');
		new Chart(enrollmentTrendCtx, {
			type: 'line',
			data: {
				labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4', 'Week 5', 'Week 6', 'Week 7'],
				datasets: [{
					label: 'Enrollment Count',
					data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.EnrollmentTrend)),
					borderColor: '#198754',
					backgroundColor: 'rgba(25, 135, 84, 0.1)',
					tension: 0.3,
					fill: true,
					borderWidth: 2
				}]
			},
			options: {
				responsive: true,
				maintainAspectRatio: true,
				plugins: {
					legend: {
						display: true
					}
				},
				scales: {
					y: {
						beginAtZero: true
					}
				}
			}
		});
	</script>
}
