@model IEnumerable<SIMS.Application.DTOs.StudentDto>

@{
	ViewData["Title"] = "Student Management";
}

<div class="container-fluid px-4">
	<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
		<h1 class="text-primary"><i class="bi bi-people-fill"></i> @ViewData["Title"]</h1>
		<a href="/Students/Create" class="btn btn-primary">
			<i class="bi bi-plus-lg"></i> Add New Student
		</a>
	</div>

	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			<i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<div class="card mb-4 shadow-sm border-0">
		<div class="card-header bg-white pt-4 pb-0">
			<h5 class="mb-0">All Students</h5>
		</div>
		<div class="card-body">
			@if (Model != null && Model.Any())
			{
				<div class="table-responsive">
					<table class="table table-hover align-middle">
						<thead class="table-light">
							<tr>
								<th>Student ID</th>
								<th>Full Name</th>
								<th>Email</th>
								<th>Department</th>
								<th>Date of Birth</th>
								<th class="text-end">Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model)
							{
								<tr>
									<td><span class="badge bg-primary">@item.StudentId</span></td>
									<td class="fw-bold">@item.FirstName @item.LastName</td>
									<td><a href="mailto:@item.Email">@item.Email</a></td>
									<td>@item.DepartmentName</td>
									<td>@item.DateOfBirth.ToString("dd/MM/yyyy")</td>
									<td class="text-end">
										<a href="/Students/Edit/@item.Id" class="btn btn-sm btn-outline-primary me-1">
											<i class="bi bi-pencil"></i> Edit
										</a>
										<form action="/Students/Delete/@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this student and their login account?');">
											@Html.AntiForgeryToken()
											<button type="submit" class="btn btn-sm btn-outline-danger">
												<i class="bi bi-trash"></i> Delete
											</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			else
			{
				<div class="alert alert-info" role="alert">
					<i class="bi bi-info-circle"></i> No students found. <a href="/Students/Create">Create one now</a>
				</div>
			}
		</div>
	</div>
</div>
