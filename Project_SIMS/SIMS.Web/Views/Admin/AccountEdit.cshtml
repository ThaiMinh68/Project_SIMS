@{
	ViewData["Title"] = "Edit User Account";
	var user = ViewBag.User;
	var userRoles = ViewBag.UserRoles;
	var allRoles = ViewBag.AllRoles;
}

<div class="container-fluid px-4">
	<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
		<h1 class="text-danger"><i class="bi bi-person-gear"></i> @ViewData["Title"]</h1>
		<a asp-action="AccountIndex" asp-controller="Admin" class="btn btn-outline-secondary">
			<i class="bi bi-arrow-left"></i> Back to List
		</a>
	</div>

	<div class="row">
		<div class="col-lg-8 offset-lg-2">
			<div class="card shadow-sm border-0">
				<div class="card-header bg-white pt-4 pb-0">
					<h5 class="mb-0">Account Information</h5>
				</div>
				<div class="card-body">
					<form asp-action="AccountEdit" asp-controller="Admin" method="post">
						<input type="hidden" name="id" value="@Model.Id">

						<div class="mb-3">
							<label class="form-label">Email Address</label>
							<input type="email" class="form-control" value="@Model.Email" disabled>
							<small class="text-muted">Email cannot be changed</small>
						</div>

						<div class="row mb-3">
							<div class="col-md-6">
								<label for="firstName" class="form-label">First Name</label>
								<input type="text" class="form-control" id="firstName" name="firstName" value="@Model.FirstName" required>
							</div>
							<div class="col-md-6">
								<label for="lastName" class="form-label">Last Name</label>
								<input type="text" class="form-control" id="lastName" name="lastName" value="@Model.LastName" required>
							</div>
						</div>

						<div class="mb-3">
							<label class="form-label">Account Status</label>
							<div class="form-check form-switch">
								<input class="form-check-input" type="checkbox" id="isActive" name="isActive" 
									   @(Model.IsActive ? "checked" : "") value="true">
								<label class="form-check-label" for="isActive">
									Account Active
								</label>
							</div>
							<small class="text-muted">Uncheck to lock the account</small>
						</div>

						<div class="mb-3">
							<label class="form-label">Assign Roles</label>
							<div class="border rounded p-3">
								@foreach (var role in allRoles)
								{
									var isChecked = userRoles != null && userRoles.Contains(role);
									<div class="form-check">
										<input class="form-check-input" type="checkbox" id="role_@role" name="roles" value="@role" 
											   @(isChecked ? "checked" : "")>
										<label class="form-check-label" for="role_@role">
											@role
										</label>
									</div>
								}
							</div>
							<small class="text-muted d-block mt-2">Select one or more roles for this user</small>
						</div>

						<div class="alert alert-info" role="alert">
							<i class="bi bi-info-circle"></i> 
							<strong>Note:</strong> Use "Reset Password" button to set a new password for this user.
						</div>

						<div class="d-flex gap-2 pt-3">
							<button type="submit" class="btn btn-danger">
								<i class="bi bi-check-circle"></i> Update Account
							</button>
							<a asp-action="ResetPassword" asp-controller="Admin" asp-route-id="@Model.Id" 
							   class="btn btn-warning" onclick="return confirm('Reset password for this user?');">
								<i class="bi bi-arrow-clockwise"></i> Reset Password
							</a>
							<a asp-action="AccountIndex" asp-controller="Admin" class="btn btn-outline-secondary">
								<i class="bi bi-x-circle"></i> Cancel
							</a>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
