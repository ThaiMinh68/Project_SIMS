@{
	ViewData["Title"] = "Change Password";
}

<div class="container-fluid px-4">
	<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
		<h1 class="text-primary"><i class="bi bi-lock"></i> @ViewData["Title"]</h1>
		<a href="@Url.Action("Profile", "Faculty")" class="btn btn-outline-secondary">
			<i class="bi bi-arrow-left"></i> Back to Profile
		</a>
	</div>

	<div class="row">
		<div class="col-lg-6 offset-lg-3">
			<div class="card shadow-sm border-0">
				<div class="card-header bg-white pt-4 pb-0">
					<h5 class="mb-0">Update Password</h5>
				</div>
				<div class="card-body">
					@if (ViewData.ModelState.Values.Any(v => v.Errors.Any()))
					{
						<div class="alert alert-danger" role="alert">
							<h6 class="alert-heading">Error!</h6>
							<ul class="mb-0">
								@foreach (var modelState in ViewData.ModelState.Values)
								{
									@foreach (var error in modelState.Errors)
									{
										<li>@error.ErrorMessage</li>
									}
								}
							</ul>
						</div>
					}

					<form method="post">
						<div class="mb-3">
							<label for="currentPassword" class="form-label">Current Password <span class="text-danger">*</span></label>
							<input type="password" class="form-control" id="currentPassword" name="currentPassword" required>
						</div>

						<div class="mb-3">
							<label for="newPassword" class="form-label">New Password <span class="text-danger">*</span></label>
							<input type="password" class="form-control" id="newPassword" name="newPassword" required>
							<small class="text-muted">Password must be at least 8 characters long</small>
						</div>

						<div class="mb-3">
							<label for="confirmPassword" class="form-label">Confirm Password <span class="text-danger">*</span></label>
							<input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required>
						</div>

						<div class="d-flex gap-2 pt-3">
							<button type="submit" class="btn btn-primary">
								<i class="bi bi-check-circle"></i> Change Password
							</button>
							<a href="@Url.Action("Profile", "Faculty")" class="btn btn-outline-secondary">
								<i class="bi bi-x-circle"></i> Cancel
							</a>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
