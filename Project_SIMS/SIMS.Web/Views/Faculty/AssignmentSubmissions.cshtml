@model IEnumerable<dynamic>

@{
	ViewData["Title"] = "Assignment Submissions - " + ViewBag.AssignmentTitle;
}

<div class="container-fluid px-4">
	<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
		<h1 class="text-info"><i class="bi bi-inbox"></i> @ViewBag.AssignmentTitle</h1>
		<a href="@Url.Action("Assignments", new { courseId = ViewBag.CourseId })" class="btn btn-outline-secondary">
			<i class="bi bi-arrow-left"></i> Back to Assignments
		</a>
	</div>

	<div class="alert alert-info" role="alert">
		<strong>Course:</strong> @ViewBag.CourseName | 
		<strong>Due Date:</strong> @ViewBag.DueDate.ToString("dd/MM/yyyy HH:mm")
	</div>

	<div class="card shadow-sm border-0">
		<div class="card-header bg-white pt-4 pb-0">
			<h5 class="mb-0">Student Submissions</h5>
		</div>
		<div class="card-body">
			@if (Model != null && Model.Any())
			{
				<div class="table-responsive">
					<table class="table table-hover align-middle">
						<thead class="table-light">
							<tr>
								<th>Student</th>
								<th>Submitted</th>
								<th>Status</th>
								<th>Score</th>
								<th class="text-end">Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var submission in Model)
							{
								<tr>
									<td>
										<strong>@submission.StudentName</strong><br>
										<small class="text-muted">@submission.StudentCode</small>
									</td>
									<td>
										@submission.SubmissionDate.ToString("dd/MM/yyyy HH:mm")
										@if (submission.IsLate)
										{
											<br>
											<span class="badge bg-danger">Late</span>
										}
									</td>
									<td>
										@if (string.IsNullOrEmpty(submission.SubmissionUrl))
										{
											<span class="badge bg-secondary">Not Submitted</span>
										}
										else
										{
											<span class="badge bg-success">Submitted</span>
										}
									</td>
									<td>
									@if (submission.Score != null)
									{
										<span class="badge bg-primary">@submission.Score/100</span>
									}
									else
									{
										<span class="text-muted">-</span>
									}
									</td>
									<td class="text-end">
										@if (!string.IsNullOrEmpty(submission.SubmissionUrl))
										{
											<a href="@submission.SubmissionUrl" target="_blank" class="btn btn-sm btn-outline-info me-1">
												<i class="bi bi-download"></i> Download
											</a>
										}
										<a href="@Url.Action("GradeSubmission", new { submissionId = submission.Id })" class="btn btn-sm btn-outline-primary">
											<i class="bi bi-pencil"></i> Grade
										</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			else
			{
				<div class="alert alert-info" role="alert">
					<i class="bi bi-info-circle"></i> No submissions yet.
				</div>
			}
		</div>
	</div>
</div>
