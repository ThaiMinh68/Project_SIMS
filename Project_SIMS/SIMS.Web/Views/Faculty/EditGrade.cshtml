@model dynamic

@{
	ViewData["Title"] = "Edit Grade";
}

<div class="container-fluid px-4">
	<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
		<h1 class="text-success"><i class="bi bi-pencil-square"></i> @ViewData["Title"]</h1>
		<a href="@Url.Action("ClassDetail", new { courseId = ViewBag.CourseId })" class="btn btn-outline-secondary">
			<i class="bi bi-arrow-left"></i> Back
		</a>
	</div>

	<div class="row">
		<div class="col-lg-6 offset-lg-3">
			<div class="card shadow-sm border-0">
				<div class="card-header bg-white pt-4 pb-0">
					<h5 class="mb-0">Student Grade Information</h5>
				</div>
				<div class="card-body">
					<p><strong>Student:</strong> @ViewBag.StudentName <span class="badge bg-primary">@ViewBag.StudentCode</span></p>

					<form asp-action="SaveGradeDetail" method="post">
						<input type="hidden" name="enrollmentId" value="@Model.Id">

						<div class="mb-3">
							<label for="grade" class="form-label">Grade <span class="text-danger">*</span></label>
							<div class="input-group">
								<input type="number" class="form-control" id="grade" name="grade"
									   min="0" max="100" step="0.5"
									   value="@Model.Grade" placeholder="Enter grade (0-100)" required>
								<span class="input-group-text">/100</span>
							</div>
						</div>

						<div class="d-flex gap-2 pt-3">
							<button type="submit" class="btn btn-success">
								<i class="bi bi-check-circle"></i> Save Grade
							</button>
							<a href="@Url.Action("ClassDetail", new { courseId = ViewBag.CourseId })" class="btn btn-outline-secondary">
								<i class="bi bi-x-circle"></i> Cancel
							</a>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
