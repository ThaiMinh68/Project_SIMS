@model dynamic

@{
	ViewData["Title"] = "Grade Submission";
}

<div class="container-fluid px-4">
	<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
		<h1 class="text-primary"><i class="bi bi-percent"></i> @ViewData["Title"]</h1>
		<a href="@Url.Action("AssignmentSubmissions", new { assignmentId = ViewBag.AssignmentId })" class="btn btn-outline-secondary">
			<i class="bi bi-arrow-left"></i> Back
		</a>
	</div>

	<div class="row">
		<div class="col-lg-8 offset-lg-2">
			<div class="card shadow-sm border-0">
				<div class="card-header bg-white pt-4 pb-0">
					<h5 class="mb-0">Student Information</h5>
				</div>
				<div class="card-body">
					<p><strong>Student:</strong> @ViewBag.StudentName <span class="badge bg-info">@ViewBag.StudentCode</span></p>
					<p><strong>Assignment:</strong> @ViewBag.AssignmentTitle</p>
					<p><strong>Due Date:</strong> @ViewBag.DueDate.ToString("dd/MM/yyyy HH:mm")</p>
				</div>
			</div>

			<div class="card shadow-sm border-0 mt-4">
				<div class="card-header bg-white pt-4 pb-0">
					<h5 class="mb-0">Grading</h5>
				</div>
				<div class="card-body">
					<form asp-action="SaveSubmissionGrade" method="post">
						<input type="hidden" name="submissionId" value="@Model.Id">

						<div class="mb-3">
							<label for="score" class="form-label">Score <span class="text-danger">*</span></label>
							<div class="input-group">
								<input type="number" class="form-control" id="score" name="score" 
									   min="0" max="100" step="0.5"
									   value="@Model.Score" placeholder="Enter score (0-100)" required>
								<span class="input-group-text">/100</span>
							</div>
						</div>

						<div class="mb-3">
							<label for="feedback" class="form-label">Feedback</label>
							<textarea class="form-control" id="feedback" name="feedback" rows="5" 
									  placeholder="Leave feedback for the student...">@Model.Feedback</textarea>
						</div>

						<div class="d-flex gap-2 pt-3">
							<button type="submit" class="btn btn-success">
								<i class="bi bi-check-circle"></i> Save Grade
							</button>
							<a href="@Url.Action("AssignmentSubmissions", new { assignmentId = ViewBag.AssignmentId })" class="btn btn-outline-secondary">
								<i class="bi bi-x-circle"></i> Cancel
							</a>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
