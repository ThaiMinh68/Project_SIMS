@using SIMS.Domain.Entities
@model IEnumerable<Assignment>

@{
	ViewData["Title"] = "Assignments - " + ViewBag.CourseName;
}

<div class="container-fluid px-4">
	<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
		<h1 class="text-warning"><i class="bi bi-file-earmark-text"></i> @ViewData["Title"]</h1>
		<a href="@Url.Action("CreateAssignment", new { courseId = ViewBag.CourseId })" class="btn btn-warning">
			<i class="bi bi-plus-lg"></i> Create Assignment
		</a>
	</div>

	<div class="alert alert-info" role="alert">
		<strong>Course:</strong> @ViewBag.CourseName
	</div>

	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			<i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
			<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		</div>
	}

	<div class="card shadow-sm border-0">
		<div class="card-header bg-white pt-4 pb-0">
			<h5 class="mb-0">All Assignments</h5>
		</div>
		<div class="card-body">
			@if (Model != null && Model.Any())
			{
				<div class="table-responsive">
					<table class="table table-hover align-middle">
						<thead class="table-light">
							<tr>
								<th>Title</th>
								<th>Due Date</th>
								<th>Submissions</th>
								<th>Created</th>
								<th class="text-end">Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var assignment in Model)
							{
								var isOverdue = DateTime.UtcNow > assignment.DueDate;
								<tr class="@(isOverdue ? "table-danger" : "")">
									<td>
										<strong>@assignment.Title</strong>
										<br>
										<small class="text-muted">@(assignment.Description?.Length > 50 ? assignment.Description.Substring(0, 50) + "..." : assignment.Description)</small>
									</td>
									<td>
										@assignment.DueDate.ToString("dd/MM/yyyy HH:mm")
										@if (isOverdue)
										{
											<br>
											<span class="badge bg-danger">Overdue</span>
										}
									</td>
									<td>
										<a href="@Url.Action("AssignmentSubmissions", new { assignmentId = assignment.Id })" class="badge bg-info text-white">
											View Submissions
										</a>
									</td>
									<td>@assignment.CreatedDate.ToString("dd/MM/yyyy")</td>
									<td class="text-end">
										<a href="@Url.Action("EditAssignment", new { id = assignment.Id })" class="btn btn-sm btn-outline-primary me-1">
											<i class="bi bi-pencil"></i> Edit
										</a>
										<form asp-action="DeleteAssignment" asp-route-id="@assignment.Id" method="post" class="d-inline" 
											  onsubmit="return confirm('Are you sure you want to delete this assignment?');">
											<button type="submit" class="btn btn-sm btn-outline-danger">
												<i class="bi bi-trash"></i> Delete
											</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			else
			{
				<div class="alert alert-info" role="alert">
					<i class="bi bi-info-circle"></i> No assignments created yet. <a href="@Url.Action("CreateAssignment", new { courseId = ViewBag.CourseId })">Create one now</a>
				</div>
			}
		</div>
	</div>
</div>
