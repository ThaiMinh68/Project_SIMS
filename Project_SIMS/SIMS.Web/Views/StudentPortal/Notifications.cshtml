@model IEnumerable<SIMS.Application.DTOs.NotificationDto>

@{
    ViewData["Title"] = "Notifications";
}

<div class="container-fluid px-4">
    <h1 class="mt-4 text-primary"><i class="bi bi-bell"></i> Thông báo</h1>

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-white pt-4 pb-0">
            <h5 class="mb-0">My Notifications</h5>
        </div>
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">No notifications found.</div>
            }
            else
            {
                <div class="list-group">
                    @foreach (var n in Model)
                    {
                        <div class="list-group-item">
                            <div class="d-flex w-100 justify-content-between">
                                <h5 class="mb-1">@n.Title</h5>
                                <small class="text-muted">@n.CreatedDate.ToString("dd/MM/yyyy")</small>
                            </div>
                            <p class="mb-1">@n.Content</p>
                            <small class="text-muted">Course: @n.CourseName</small>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>