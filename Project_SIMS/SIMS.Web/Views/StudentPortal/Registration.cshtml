@model IEnumerable<SIMS.Application.DTOs.AvailableCourseDto>

@{
    ViewData["Title"] = "Course Registration";
}

<div class="container-fluid px-4">
    <h1 class="mt-4 text-primary"><i class="bi bi-card-checklist"></i> @ViewData["Title"]</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active">Course Registration</li>
    </ol>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-white pt-4 pb-0">
            <h5 class="mb-0 text-success"><i class="bi bi-list-task"></i> Available Courses (Current Semester)</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Course Code</th>
                            <th>Course Title</th>
                            <th>Credits</th>
                            <th>Department</th>
                            <th>Faculty</th>
                            <th>Enrollment Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@item.Code</span></td>
                                <td class="fw-bold">@item.Title</td>
                                <td>@item.Credits</td>
                                <td>@item.DepartmentName</td>
                                <td>
                                    @if(item.IsEnrolled)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check2"></i> Enrolled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">Not Enrolled</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if(item.IsEnrolled)
                                    {
                                        <form asp-action="Drop" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to drop this course?');">
                                            <input type="hidden" name="courseId" value="@item.CourseId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x-circle"></i> Drop
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Enroll" method="post" class="d-inline">
                                            <input type="hidden" name="courseId" value="@item.CourseId" />
                                            <button type="submit" class="btn btn-sm btn-primary">
                                                <i class="bi bi-plus-circle"></i> Enroll
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
